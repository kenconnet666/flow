<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.dpdns.zerodep</groupId>
    <artifactId>flow-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>flow</name>
    <description>Approval workflow engine for Spring Boot on easy-query, with a shared model package.</description>
    <url>https://github.com/kenconnet666/flow</url>
    <developers>
        <developer>
            <id>kenconnet666</id>
            <name>lionheart</name>
            <url>https://github.com/kenconnet666</url>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/kenconnet666/flow</url>
        <connection>scm:git:https://github.com/kenconnet666/flow.git</connection>
        <developerConnection>scm:git:git@github.com:kenconnet666/flow.git</developerConnection>
    </scm>
    <!-- 模块按 docs/decisions/0001 的"模块划分"：模型包、引擎、实库测试；Spring 适配随后加 -->
    <modules>
        <module>java/flow-model</module>
        <module>java/flow-core</module>
        <module>java/flow-spring</module>
        <!-- 给接入方的契约核对：在自己的测试里继承 FlowContractTest -->
        <module>java/flow-test-kit</module>
        <module>java/flow-it</module>
        <!-- 示例项目也在构建里：CI 编译它，保证示例跟得上引擎 -->
        <module>examples/spring-boot</module>
    </modules>
    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- json-wire（typed JSON）：模型包与引擎用它读写 JSON 文字、还原强类型的值；本机在 ../json-wire 里 mvnw install，CI 先构建它 -->
        <json-wire.version>0.1.0-SNAPSHOT</json-wire.version>
        <!-- 持久层：easy-query 的强类型查询（APT 为实体生成代理类）；实体与 VO 用 Lombok -->
        <easy-query.version>3.3.1-zd.1</easy-query.version>
        <lombok.version>1.18.46</lombok.version>
        <mysql.version>9.7.0</mysql.version>
        <!-- 只在实库测试里用来执行建表脚本；接入方用自己项目的 Flyway -->
        <flyway.version>12.4.0</flyway.version>
        <!-- flow-spring 按 Spring Boot 3.5 编译（Java 17 起），只用 3.5 与 4.x 都有的写法，两条线都能用 -->
        <spring-boot.version>3.5.16</spring-boot.version>
        <!-- 同 Spring Boot 3.5.16 管理的版本：flow-it 的测试不导入 Boot 的 BOM，单独写 -->
        <micrometer.version>1.15.12</micrometer.version>
        <junit.version>6.0.3</junit.version>
        <surefire.version>3.6.0</surefire.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.dpdns.zerodep</groupId>
                <artifactId>json-wire</artifactId>
                <version>${json-wire.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dpdns.zerodep.easyquery</groupId>
                <artifactId>sql-api-proxy</artifactId>
                <version>${easy-query.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dpdns.zerodep.easyquery</groupId>
                <artifactId>sql-mysql</artifactId>
                <version>${easy-query.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dpdns.zerodep.easyquery</groupId>
                <artifactId>sql-springboot-starter</artifactId>
                <version>${easy-query.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-mysql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dpdns.zerodep</groupId>
                <artifactId>flow-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dpdns.zerodep</groupId>
                <artifactId>flow-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dpdns.zerodep</groupId>
                <artifactId>flow-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.dpdns.zerodep</groupId>
                <artifactId>flow-test-kit</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <!-- Lombok 先补 getter / setter，easy-query 再为实体生成代理类（查询里的 o.state() 这类） -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.dpdns.zerodep.easyquery</groupId>
                                <artifactId>sql-processor</artifactId>
                                <version>${easy-query.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                    <configuration>
                        <argLine>-Xmx512m -Dfile.encoding=UTF-8</argLine>
                        <!-- 实库测试整套要 4～5 分钟（场景用例占一半），库被别的进程占着时更慢：只防卡死，给到 10 分钟 -->
                        <forkedProcessTimeoutInSeconds>600</forkedProcessTimeoutInSeconds>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                    <executions>
                        <execution>
                            <id>default-jar</id>
                            <configuration>
                                <archive>
                                    <manifestEntries>
                                        <Automatic-Module-Name>${automatic.module.name}</Automatic-Module-Name>
                                    </manifestEntries>
                                </archive>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
