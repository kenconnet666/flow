{
  "name": "采购：金额大的经财务复核、总经理审批后结束；收件箱只给候选人看，先认领先得",
  "forms": ["forms/purchase-form.json"],
  "processes": ["processes/purchase.json"],
  "clock": "2026-10-26T08:00:00Z",
  "actors": {
    "alice": { "id": 1001, "name": "林小满" },
    "bob": { "id": 1002, "name": "周启航", "roles": [1] },
    "carol": { "id": 1003, "name": "沈若水" },
    "boss": { "id": 1004, "name": "总经理" }
  },
  "steps": [
    { "id": "start", "as": "alice", "command": "start",
      "args": { "key": "purchase", "form": { "title": "办公桌", "amount": "12000.00" } },
      "expect": {
        "instance": { "title": "采购申请：办公桌", "status": "active", "current": [{ "node": "review", "name": "财务复核" }] },
        "workItems": [{ "node": "review", "state": "open", "assignment": "pool", "inboxKind": "role", "inboxId": "1", "assigneeId": null }],
        "events": ["instance.started", "node.left", "node.entered", "workItem.created"]
      } },
    { "as": "bob", "command": "todo", "args": { "page": 1, "size": 10 },
      "expect": { "total": 1, "rows": [{ "workItem": { "node": "review" }, "title": "采购申请：办公桌", "summary": { "form.title": "办公桌", "form.amount": "12000.00" } }] } },
    { "as": "carol", "command": "todo", "expect": { "total": 0, "rows": [] } },
    { "as": "carol", "command": "claim", "args": { "workItem": "$start.workItems[0]" }, "expect": { "error": { "code": "flow.not-candidate" } } },
    { "as": "bob", "command": "claim", "args": { "workItem": "$start.workItems[0]" }, "expect": { "events": ["workItem.claimed"] } },
    { "as": "carol", "command": "claim", "args": { "workItem": "$start.workItems[0]" }, "expect": { "error": { "code": "flow.already-claimed" } } },
    { "id": "review", "as": "bob", "command": "complete",
      "args": { "workItem": "$start.workItems[0]", "outcome": "pass", "comment": "同意", "form": { "note": "预算内" } },
      "expect": {
        "closed": [{ "node": "review" }],
        "workItems": [{ "node": "approve", "assignment": "direct", "assigneeId": "1004", "assigneeName": "总经理" }],
        "instance": { "current": [{ "node": "approve", "name": "总经理审批" }] }
      } },
    { "as": "boss", "command": "complete", "args": { "workItem": "$review.workItems[0]", "outcome": "pass" },
      "expect": { "instance": { "status": "completed", "result": "approved", "current": [] }, "workItems": [] } },
    { "as": "alice", "command": "instance", "args": { "instance": "$start.instance" },
      "expect": {
        "form": { "values": { "title": "办公桌", "amount": "12000.00", "note": "预算内" } },
        "diagram": {
          "nodes": [
            { "id": "start", "type": "start", "state": "done" },
            { "id": "review", "name": "财务复核", "type": "task", "x": null, "state": "done" },
            { "id": "route", "type": "exclusive", "state": "done" },
            { "id": "approve", "state": "done" },
            { "id": "done", "type": "end", "state": "done" },
            { "id": "rejected", "state": "pending" }
          ],
          "edges": [
            { "id": "submit", "taken": true },
            { "id": "reviewed", "label": "通过", "taken": true },
            { "id": "refused", "label": "否决", "taken": false },
            { "id": "large", "label": null, "taken": true },
            { "id": "small", "taken": false },
            { "id": "approved", "label": "同意", "taken": true }
          ]
        },
        "workItems": [
          { "node": "review", "state": "done", "outcome": "pass", "comment": "同意", "completedBy": "1002", "completedByName": "周启航" },
          { "node": "approve", "state": "done", "outcome": "pass", "completedBy": "1004" }
        ]
      } }
  ],
  "$types": {
    "steps.args.form.amount": "decimal"
  }
}
