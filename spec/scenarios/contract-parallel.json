{
  "name": "合同会审（并行网关）：法务与财务同时审，两边都通过才往下走；先办完的一边等另一边",
  "forms": [
    "forms/contract-form.json"
  ],
  "processes": [
    "processes/contract-parallel.json"
  ],
  "clock": "2026-10-26T08:00:00Z",
  "actors": {
    "alice": {
      "id": 1001,
      "name": "林小满"
    },
    "bob": {
      "id": 1002,
      "name": "周启航",
      "roles": [
        1
      ]
    },
    "dave": {
      "id": 1005,
      "name": "韩笑",
      "roles": [
        3
      ]
    }
  },
  "steps": [
    {
      "id": "start",
      "as": "alice",
      "command": "start",
      "args": {
        "key": "contract-parallel",
        "form": {
          "title": "办公楼租赁",
          "amount": "50000.00"
        }
      },
      "expect": {
        "instance": {
          "status": "active",
          "current": [
            {
              "node": "legal"
            },
            {
              "node": "finance"
            }
          ]
        },
        "workItems": [
          {
            "node": "legal",
            "assignment": "pool",
            "inboxId": "3"
          },
          {
            "node": "finance",
            "assignment": "pool",
            "inboxId": "1"
          }
        ],
        "events": [
          "instance.started",
          "node.left",
          "node.entered",
          "node.left",
          "node.entered",
          "workItem.created",
          "node.left",
          "node.entered",
          "workItem.created"
        ]
      }
    },
    {
      "as": "dave",
      "command": "complete",
      "args": {
        "workItem": "$start.workItems[0]",
        "outcome": "pass"
      },
      "expect": {
        "instance": {
          "status": "active",
          "current": [
            {
              "node": "finance"
            }
          ]
        },
        "workItems": [],
        "events": [
          "workItem.completed",
          "node.left",
          "node.entered"
        ]
      }
    },
    {
      "as": "bob",
      "command": "complete",
      "args": {
        "workItem": "$start.workItems[1]",
        "outcome": "pass"
      },
      "expect": {
        "instance": {
          "status": "completed",
          "result": "approved",
          "current": []
        },
        "workItems": [],
        "events": [
          "workItem.completed",
          "node.left",
          "node.entered",
          "node.left",
          "node.entered",
          "instance.finished"
        ]
      }
    }
  ],
  "$types": {
    "steps.args.form.amount": "decimal"
  }
}
