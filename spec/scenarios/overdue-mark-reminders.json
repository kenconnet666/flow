{
  "name": "时限按工作日跳过周末；超时默认只记一条“超时”，待办照样等人处理；超时后每隔四小时提醒，最多两次",
  "forms": [],
  "processes": ["processes/ticket.json"],
  "clock": "2026-10-26T08:00:00Z",
  "actors": {
    "alice": { "id": 1001, "name": "林小满" },
    "bob": { "id": 1002, "name": "周启航", "roles": [1] }
  },
  "steps": [
    { "id": "start", "as": "alice", "command": "start", "args": { "key": "ticket" },
      "expect": { "workItems": [{ "node": "handle", "assigneeId": "1002", "dueAt": "2026-11-02T08:00:00Z" }] } },
    { "command": "runJobs", "args": { "at": "2026-11-02T07:59:59Z" }, "expect": { "ran": 0 } },
    { "command": "runJobs", "args": { "at": "2026-11-02T08:00:00Z" }, "expect": { "ran": 1 } },
    { "as": "bob", "command": "workItem", "args": { "workItem": "$start.workItems[0]" },
      "expect": { "workItem": { "state": "open" }, "completable": true } },
    { "command": "runJobs", "args": { "at": "2026-11-02T12:00:00Z" }, "expect": { "ran": 1 } },
    { "command": "runJobs", "args": { "at": "2026-11-02T16:00:00Z" }, "expect": { "ran": 1 } },
    { "command": "runJobs", "args": { "at": "2026-11-02T20:00:00Z" }, "expect": { "ran": 0 } },
    { "as": "bob", "command": "complete", "args": { "workItem": "$start.workItems[0]", "outcome": "fixed" },
      "expect": { "instance": { "status": "completed", "result": "fixed" } } },
    { "as": "alice", "command": "instance", "args": { "instance": "$start.instance" },
      "expect": { "timeline": [
        "instance.started", "node.left", "node.entered", "workItem.created",
        { "type": "workItem.overdue", "data": { "dueAt": "2026-11-02T08:00:00Z" } },
        { "type": "workItem.reminded", "data": { "reason": "overdue" } },
        { "type": "workItem.reminded", "data": { "reason": "overdue" } },
        { "type": "workItem.completed", "actorId": "1002" },
        "node.left", "node.entered", "instance.finished"
      ] } }
  ]
}
