{
  "name": "抄送：处理人手动抄送（知会）；抄送节点把发起人与法务角色下的人都抄送到，不停；抄送我的未读在前，读过标已读",
  "forms": [],
  "processes": ["processes/notice.json"],
  "clock": "2026-10-26T08:00:00Z",
  "actors": {
    "alice": { "id": 1001, "name": "林小满" },
    "carol": { "id": 1003, "name": "沈若水" },
    "boss": { "id": 1004, "name": "总经理", "roles": [2] },
    "han": { "id": 1005, "name": "韩笑", "roles": [3] }
  },
  "steps": [
    { "id": "start", "as": "alice", "command": "start", "args": { "key": "notice" } },
    { "as": "boss", "command": "cc", "args": { "instance": "$start.instance", "users": [1003], "message": "知会一下" },
      "expect": { "events": [{ "type": "instance.cc", "actorId": "1004", "comment": "知会一下", "data": { "userNames": ["沈若水"] } }] } },
    { "as": "carol", "command": "ccList",
      "expect": { "total": 1, "rows": [{ "node": null, "recipientId": "1003", "fromUserId": "1004", "fromUserName": "总经理", "message": "知会一下", "readAt": null, "instance": {"title": "发文审批", "status": "active"} }] } },
    { "as": "boss", "command": "complete", "args": { "workItem": "$start.workItems[0]", "outcome": "sign" },
      "expect": {
        "instance": { "status": "completed", "result": "signed" },
        "events": [
          "workItem.completed", "node.left", "node.entered",
          { "type": "instance.cc", "node": "notify", "comment": "已签发", "data": { "userNames": ["林小满", "韩笑"] } },
          "node.left", "node.entered", "instance.finished"
        ] } },
    { "as": "alice", "command": "ccList",
      "expect": { "total": 1, "rows": [{ "node": "notify", "nodeName": "分发", "fromUserId": null, "message": "已签发", "instance": {"status": "completed"} }] } },
    { "as": "han", "command": "ccList", "expect": { "total": 1 } },
    { "as": "carol", "command": "readCc", "args": { "instance": "$start.instance" }, "expect": { "read": 1 } },
    { "as": "carol", "command": "readCc", "args": { "instance": "$start.instance" }, "expect": { "read": 0 } },
    { "as": "carol", "command": "ccList", "expect": { "rows": [{ "readAt": "2026-10-26T08:00:00Z" }] } },
    { "as": "boss", "command": "cc", "args": { "instance": "$start.instance", "users": [] },
      "expect": { "error": { "code": "flow.validation-failed" } } }
  ]
}
