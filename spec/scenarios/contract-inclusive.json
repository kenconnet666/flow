            {
              "node": "legal"
            }
          ]
        }
      }
    },
    {
      "as": "dave",
      "command": "complete",
      "args": {
        "workItem": "$large.workItems[0]",
        "outcome": "pass"
      },
      "expect": {
        "instance": {
          "status": "completed",
          "result": "approved"
        }
      }
    }
