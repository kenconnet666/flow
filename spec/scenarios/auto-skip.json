{
  "name": "自动跳过：处理人是发起人、和上一步同一个人时不生成待办，按同意往下走；节点上的设置盖过流程级的",
  "forms": [],
  "processes": ["processes/auto-skip.json"],
  "clock": "2026-10-26T08:00:00Z",
  "actors": {
    "alice": { "id": 1001, "name": "林小满" },
    "carol": { "id": 1003, "name": "沈若水" }
  },
  "steps": [
    { "id": "start", "as": "alice", "command": "start", "args": { "key": "auto-skip" },
      "expect": {
        "workItems": [{ "node": "review", "assigneeId": "1003" }],
        "events": ["instance.started", "node.left", "node.entered",
          { "type": "node.skipped", "node": "confirm", "outcome": "ok", "data": { "reason": "initiator", "userName": "林小满" } },
          "node.left", "node.entered", "workItem.created"]
      } },
    { "id": "reviewed", "as": "carol", "command": "complete", "args": { "workItem": "$start.workItems[0]", "outcome": "ok" },
      "expect": {
        "workItems": [{ "node": "final", "assigneeId": "1003" }],
        "events": ["workItem.completed", "node.left", "node.entered",
          { "type": "node.skipped", "node": "approve", "data": { "reason": "sameAsPrevious", "userName": "沈若水" } },
          "node.left", "node.entered", "workItem.created"]
      } },
    { "as": "carol", "command": "complete", "args": { "workItem": "$reviewed.workItems[0]", "outcome": "ok" },
      "expect": { "instance": { "status": "completed" } } }
  ]
}
