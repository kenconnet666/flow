{
  "key": "return-choose",
  "name": "合同审批（退回时选节点）",
  "title": "合同审批",
  "nodes": [
    { "id": "start", "type": "start", "name": "提交" },
    { "id": "draft", "type": "task", "name": "起草合同", "assignees": [{ "initiator": true }],
      "outcomes": [{ "key": "submit", "label": "提交" }] },
    { "id": "review", "type": "task", "name": "部门审核", "assignees": [{ "role": 1 }],
      "outcomes": [{ "key": "pass", "label": "通过" }] },
    { "id": "fork", "type": "parallel", "name": "分头会审" },
    { "id": "legal", "type": "task", "name": "法务审核", "assignees": [{ "role": 3 }],
      "outcomes": [
        { "key": "pass", "label": "通过" },
        { "key": "back", "label": "退回", "kind": "return", "target": "choose", "comment": "required" }
      ] },
    { "id": "finance", "type": "task", "name": "财务审核", "assignees": [{ "role": 4 }],
      "outcomes": [{ "key": "pass", "label": "通过" }] },
    { "id": "join", "type": "parallel", "name": "会审汇合" },
    { "id": "approve", "type": "task", "name": "总经理审批", "assignees": [{ "role": 2 }], "returnTo": "resubmit",
      "outcomes": [
        { "key": "pass", "label": "同意" },
        { "key": "back", "label": "退回", "kind": "return", "target": "choose" }
      ] },
    { "id": "done", "type": "end", "name": "通过", "result": "approved" }
  ],
  "edges": [
    { "id": "s", "from": "start", "to": "draft" },
    { "id": "submitted", "from": "draft", "to": "review", "outcome": "submit" },
    { "id": "reviewed", "from": "review", "to": "fork", "outcome": "pass" },
    { "id": "toLegal", "from": "fork", "to": "legal" },
    { "id": "toFinance", "from": "fork", "to": "finance" },
    { "id": "legalDone", "from": "legal", "to": "join", "outcome": "pass" },
    { "id": "financeDone", "from": "finance", "to": "join", "outcome": "pass" },
    { "id": "toApprove", "from": "join", "to": "approve" },
    { "id": "approved", "from": "approve", "to": "done", "outcome": "pass" }
  ]
