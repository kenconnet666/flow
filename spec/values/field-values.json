{
  "description": "单个值合不合字段清单（field-values）：每个用例给字段与值，期望的问题 [相对路径, 原因]；空值不查。",
  "cases": [
    { "name": "文字：类型", "field": { "label": "t", "type": "text" }, "value": 5, "expect": [["", "type"]] },
    { "name": "文字：长度按 UTF-16 计", "field": { "label": "t", "type": "text", "minLength": 2, "maxLength": 3 }, "value": "a", "expect": [["", "minLength"]] },
    { "name": "文字：太长", "field": { "label": "t", "type": "text", "maxLength": 3 }, "value": "钢材订单", "expect": [["", "maxLength"]] },
    { "name": "文字：正则要整段匹配", "field": { "label": "t", "type": "text", "pattern": "[A-Z]+" }, "value": "ABc", "expect": [["", "pattern"]] },
    { "name": "文字：正则通过", "field": { "label": "t", "type": "text", "pattern": "[A-Z]+\\d{2}" }, "value": "AB12", "expect": [] },
    { "name": "空值不查", "field": { "label": "t", "type": "text", "minLength": 3 }, "value": "", "expect": [] },
    { "name": "数字：文字不行", "field": { "label": "n", "type": "number" }, "value": "3", "expect": [["", "type"]] },
    { "name": "数字：要整数", "field": { "label": "n", "type": "number", "integer": true, "max": 10 }, "value": 10.5, "expect": [["", "integer"], ["", "max"]] },
    { "name": "数字：下限", "field": { "label": "n", "type": "number", "min": 1 }, "value": 0, "expect": [["", "min"]] },
    { "name": "小数：JavaScript 的数不行（要 Decimal）", "field": { "label": "d", "type": "decimal" }, "value": 19.9, "expect": [["", "type"]] },
    { "name": "小数：文字不行（线上要标成 decimal）", "field": { "label": "d", "type": "decimal" }, "value": "1e3", "expect": [["", "type"]] },
    { "name": "小数：小数位末尾的零不算", "field": { "label": "d", "type": "decimal", "scale": 2 }, "value": "19.900", "expect": [], "$types": {"value": "decimal"} },
    { "name": "小数：小数位太多", "field": { "label": "d", "type": "decimal", "scale": 2 }, "value": "19.901", "expect": [["", "scale"]], "$types": {"value": "decimal"} },
    { "name": "小数：范围按精确小数比", "field": { "label": "d", "type": "decimal", "min": "0", "max": "99999999999999999999.99" }, "value": "99999999999999999999.991", "expect": [["", "max"]], "$types": {"value": "decimal"} },
    { "name": "是否", "field": { "label": "b", "type": "boolean" }, "value": "true", "expect": [["", "type"]] },
    { "name": "日期：读不成日子的文字不行", "field": { "label": "d", "type": "date" }, "value": "2026-02-29", "expect": [["", "type"]] },
    { "name": "日期：闰年", "field": { "label": "d", "type": "date", "max": "2028-12-31" }, "value": "2028-02-29", "expect": [], "$types": {"value": "date"} },
    { "name": "日期：范围", "field": { "label": "d", "type": "date", "min": "2026-10-01" }, "value": "2026-09-30", "expect": [["", "min"]], "$types": {"value": "date"} },
    { "name": "时间：文字不行（线上要标成 timestamptz）", "field": { "label": "t", "type": "datetime" }, "value": "2026-10-24T08:00:00", "expect": [["", "type"]] },
    { "name": "时间：毫秒", "field": { "label": "t", "type": "datetime" }, "value": "2026-10-24T08:00:00.123Z", "expect": [], "$types": {"value": "timestamptz"} },
    { "name": "时间：读不成时刻的文字不行", "field": { "label": "t", "type": "datetime" }, "value": "2026-10-24T24:00Z", "expect": [["", "type"]] },
    { "name": "选项：不在列表里", "field": { "label": "s", "type": "select", "options": [{ "value": "a", "label": "甲" }] }, "value": "b", "expect": [["", "option"]] },
    { "name": "选项：数字的值", "field": { "label": "s", "type": "select", "options": [{ "value": 1, "label": "一" }] }, "value": 1, "expect": [] },
    { "name": "选项：数字与文字不相等", "field": { "label": "s", "type": "select", "options": [{ "value": 1, "label": "一" }] }, "value": "1", "expect": [["", "option"]] },
    { "name": "选项：多选要数组", "field": { "label": "s", "type": "select", "multiple": true, "options": [{ "value": "a", "label": "甲" }] }, "value": "a", "expect": [["", "type"]] },
    { "name": "选项：字典的值只查形状", "field": { "label": "s", "type": "select", "multiple": true, "options": { "source": "supplier" } }, "value": ["s1", "s2"], "expect": [] },
    { "name": "人员：类型与人数", "field": { "label": "p", "type": "people", "types": ["user"], "max": 1 }, "value": [{ "id": 1001, "type": "user", "name": "甲" }, { "id": 10, "type": "department", "name": "乙部" }], "expect": [["", "peopleType"], ["", "maxCount"]] },
    { "name": "人员：形状不对", "field": { "label": "p", "type": "people" }, "value": ["u1"], "expect": [["", "type"]] },
    { "name": "附件：个数与大小", "field": { "label": "f", "type": "file", "maxCount": 1, "maxSize": 100 }, "value": [{ "id": "f1", "name": "a.pdf", "size": 50 }, { "id": "f2", "name": "b.pdf", "size": 200 }], "expect": [["", "maxCount"], ["", "maxSize"]] },
    { "name": "明细表：行数与格子", "field": { "label": "l", "type": "list", "minItems": 3, "fields": { "item": { "label": "物品", "type": "text", "maxLength": 2 }, "price": { "label": "单价", "type": "decimal" } } },
      "value": [{ "item": "纸", "price": "1.5" }, { "item": "钢材订单", "price": 3 }], "expect": [["", "minItems"], ["[1].item", "maxLength"], ["[1].price", "type"]], "$types": {"value.price": "decimal"} },
    { "name": "接入方注册的类型不查", "field": { "label": "m", "type": "money" }, "value": { "amount": "1", "currency": "CNY" }, "expect": [] }
  ]
}
