{
  "name": "嵌套的并行与包容：配对正确，退回跳出并行区域也没问题",
  "definition": {
    "key": "nested",
    "name": "嵌套",
    "variables": [{ "name": "big", "type": "boolean" }],
    "nodes": [
      { "id": "start", "type": "start", "name": "提交" },
      { "id": "prepare", "type": "task", "name": "准备", "assignees": [{ "initiator": true }], "outcomes": [{ "key": "ok", "label": "好" }] },
      { "id": "outer", "type": "parallel", "name": "外层分叉" },
      { "id": "inner", "type": "inclusive", "name": "内层分叉" },
      { "id": "a", "type": "task", "name": "甲", "assignees": [{ "user": 1001 }], "outcomes": [{ "key": "ok", "label": "好" }] },
      { "id": "b", "type": "task", "name": "乙", "assignees": [{ "user": 1002 }], "outcomes": [{ "key": "ok", "label": "好" }] },
      { "id": "innerJoin", "type": "inclusive", "name": "内层汇合" },
      { "id": "c", "type": "task", "name": "丙", "assignees": [{ "user": 1003 }], "outcomes": [{ "key": "ok", "label": "好" }, { "key": "back", "label": "退回", "kind": "return" }] },
      { "id": "outerJoin", "type": "parallel", "name": "外层汇合" },
      { "id": "end", "type": "end", "name": "结束" }
    ],
    "edges": [
      { "id": "e1", "from": "start", "to": "prepare" },
      { "id": "e2", "from": "prepare", "to": "outer" },
      { "id": "e3", "from": "outer", "to": "inner" },
      { "id": "e4", "from": "outer", "to": "c" },
      { "id": "e5", "from": "inner", "to": "a", "when": { "field": "big", "op": "eq", "value": true } },
      { "id": "e6", "from": "inner", "to": "b", "default": true },
      { "id": "e7", "from": "a", "to": "innerJoin" },
      { "id": "e8", "from": "b", "to": "innerJoin" },
      { "id": "e9", "from": "innerJoin", "to": "outerJoin" },
      { "id": "e10", "from": "c", "to": "outerJoin", "outcome": "ok" },
      { "id": "e11", "from": "c", "to": "prepare", "outcome": "back", "kind": "return" },
      { "id": "e12", "from": "outerJoin", "to": "end" }
    ]
  },
  "expect": []
}
