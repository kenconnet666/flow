{
  "description": "条件求值的样例：TS 的 evaluateCondition 与 Java 的 Conditions.evaluate 都要得到 expect。每个用例用 values（没写时用最外层的 values）作为字段的值。",
  "values": {
    "form.amount": "1234.50",
    "form.big": "123456789012345678901234567890.01",
    "form.count": 3,
    "form.title": "Steel Order 钢材",
    "form.urgent": true,
    "form.signDate": "2026-10-24",
    "form.tags": ["a", "b"],
    "form.reviewers": ["u1", "u2"],
    "form.none": null,
    "form.emptyText": "",
    "form.emptyList": [],
    "round": 2
  },
  "cases": [
    { "name": "等于：小数文字与数字", "condition": { "field": "form.amount", "op": "eq", "value": 1234.5 }, "expect": true },
    { "name": "等于：数字与数字文字", "condition": { "field": "form.count", "op": "eq", "value": "3" }, "expect": true },
    { "name": "等于：布尔与文字", "condition": { "field": "form.urgent", "op": "eq", "value": "true" }, "expect": true },
    { "name": "等于：文字区分大小写", "condition": { "field": "form.title", "op": "eq", "value": "steel order 钢材" }, "expect": false },
    { "name": "不等于：空值算满足", "condition": { "field": "form.none", "op": "ne", "value": "x" }, "expect": true },
    { "name": "不等于：缺的字段算满足", "condition": { "field": "form.missing", "op": "ne", "value": "x" }, "expect": true },
    { "name": "大于：精确小数", "condition": { "field": "form.amount", "op": "gt", "value": "1234.49" }, "expect": true },
    { "name": "大于：末尾的零不算", "condition": { "field": "form.amount", "op": "gt", "value": "1234.500" }, "expect": false },
    { "name": "大于等于：相等", "condition": { "field": "form.amount", "op": "gte", "value": "1234.5" }, "expect": true },
    { "name": "小于：负数", "condition": { "field": "form.amount", "op": "lt", "value": "-1" }, "expect": false },
    { "name": "大数不丢精度", "condition": { "field": "form.big", "op": "gt", "value": "123456789012345678901234567890" }, "expect": true },
    { "name": "大数不丢精度：差在最后一位", "condition": { "field": "form.big", "op": "lt", "value": "123456789012345678901234567890.02" }, "expect": true },
    { "name": "指数写法", "condition": { "field": "form.amount", "op": "lt", "value": "1.3e3" }, "expect": true },
    { "name": "小于等于：空值不满足", "condition": { "field": "form.none", "op": "lte", "value": 5 }, "expect": false },
    { "name": "日期按文字比", "condition": { "field": "form.signDate", "op": "gt", "value": "2026-10-01" }, "expect": true },
    { "name": "文字按编码顺序比", "condition": { "field": "form.title", "op": "lt", "value": "Z" }, "expect": true },
    { "name": "介于：含两端", "condition": { "field": "form.amount", "op": "between", "value": ["1000", "1234.50"] }, "expect": true },
    { "name": "介于：一端为空不限", "condition": { "field": "form.amount", "op": "between", "value": [null, "1000"] }, "expect": false },
    { "name": "介于：空值不满足", "condition": { "field": "form.none", "op": "between", "value": [1, 2] }, "expect": false },
    { "name": "是其中之一", "condition": { "field": "form.count", "op": "in", "value": ["1", "3"] }, "expect": true },
    { "name": "不在其中：空值算满足", "condition": { "field": "form.none", "op": "notIn", "value": ["1"] }, "expect": true },
    { "name": "包含：不分大小写", "condition": { "field": "form.title", "op": "contains", "value": "steel" }, "expect": true },
    { "name": "包含：中文", "condition": { "field": "form.title", "op": "contains", "value": "钢" }, "expect": true },
    { "name": "不包含：空值算满足", "condition": { "field": "form.none", "op": "notContains", "value": "x" }, "expect": true },
    { "name": "开头是", "condition": { "field": "form.title", "op": "startsWith", "value": "STEEL" }, "expect": true },
    { "name": "有值", "condition": { "field": "form.title", "op": "exists" }, "expect": true },
    { "name": "有值：空文字不算", "condition": { "field": "form.emptyText", "op": "exists" }, "expect": false },
    { "name": "没有值：空数组", "condition": { "field": "form.emptyList", "op": "empty" }, "expect": true },
    { "name": "没有值：缺的字段", "condition": { "field": "form.missing", "op": "empty" }, "expect": true },
    { "name": "数组：等于是有一项相等", "condition": { "field": "form.reviewers", "op": "eq", "value": "u2" }, "expect": true },
    { "name": "数组：不等于是没有一项相等", "condition": { "field": "form.reviewers", "op": "ne", "value": "u2" }, "expect": false },
    { "name": "数组：是其中之一", "condition": { "field": "form.tags", "op": "in", "value": ["b", "c"] }, "expect": true },
    { "name": "数组：不在其中", "condition": { "field": "form.tags", "op": "notIn", "value": ["c"] }, "expect": true },
    { "name": "流程变量", "condition": { "field": "round", "op": "gte", "value": 2 }, "expect": true },
    { "name": "全部满足", "condition": { "all": [{ "field": "form.amount", "op": "gt", "value": "1000" }, { "field": "form.urgent", "op": "eq", "value": true }] }, "expect": true },
    { "name": "任一满足", "condition": { "any": [{ "field": "form.amount", "op": "gt", "value": "9999" }, { "field": "round", "op": "eq", "value": 2 }] }, "expect": true },
    { "name": "取反", "condition": { "not": { "field": "form.urgent", "op": "eq", "value": true } }, "expect": false },
    { "name": "没写完的比较不加条件", "condition": { "all": [{ "field": "form.amount", "op": "gt" }, { "field": "round", "op": "eq", "value": 3 }] }, "expect": false },
    { "name": "空的组不加条件", "condition": { "all": [] }, "expect": true },
    { "name": "取反一个不加条件的比较仍不加条件", "condition": { "not": { "field": "form.amount", "op": "in", "value": [] } }, "expect": true },
    { "name": "单独给值", "values": { "x": "007" }, "condition": { "field": "x", "op": "eq", "value": 7 }, "expect": true }
  ],
  "complete": [
    { "name": "写完整的", "condition": { "all": [{ "field": "a", "op": "exists" }, { "field": "b", "op": "between", "value": [1, null] }] }, "expect": true },
    { "name": "空的组", "condition": { "any": [] }, "expect": false },
    { "name": "缺值", "condition": { "not": { "field": "a", "op": "eq" } }, "expect": false },
    { "name": "介于两端都空", "condition": { "field": "a", "op": "between", "value": [null, ""] }, "expect": false }
  ]
}
