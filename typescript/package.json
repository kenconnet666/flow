{
  "name": "flow-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Approval workflow for TypeScript: the model package and the UI (the backend is Java, see ../java)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "tsc -b && node --test \"test/dist/unit/**/*.test.js\"",
    "typecheck:ui": "pnpm --filter @zerodep-dev/flow-ui --filter @zerodep-dev/flow-demo typecheck",
    "test:ui": "pnpm --filter @zerodep-dev/flow-ui test"
  },
  "devDependencies": {
    "typescript": "7.1.0-dev.20261023.1"
  },
  "packageManager": "pnpm@11.22.0"
}
