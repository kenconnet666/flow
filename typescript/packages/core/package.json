{
  "name": "@zerodep-dev/flow-core",
  "version": "0.1.0-dev",
  "type": "module",
  "description": "The approval workflow engine for Node: commands, queries, jobs and the default storage on query (same behaviour as the Java flow-core)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenconnet666/flow.git",
    "directory": "typescript/packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "sql"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
