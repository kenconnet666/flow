  },
  "dependencies": {
    "@zerodep-dev/flow-model": "workspace:*",
    "@zerodep-dev/query-core": "link:../../../../query/typescript/packages/core"
  },
  "peerDependencies": {
    "@internationalized/date": "^3.12.0",
    "decimal.js": "^10.6.0"
  },
  "devDependencies": {
    "@internationalized/date": "catalog:",
    "decimal.js": "catalog:",
    "@types/node": "catalog:"
  }
}
