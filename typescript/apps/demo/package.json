  "private": true,
  "type": "module",
  "description": "Demo app of the workflow engine with its documentation: start, inbox, approval and administration against the example backend, next to the tutorials, administration and integration guides (with screenshots) that a reader can follow in the same site",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "typecheck": "tsc -p .",
    "seed": "node seed/seed.ts",
    "e2e": "node --test \"e2e/**/*.test.ts\"",
    "shots": "node shots/run.ts",
    "seed:export": "node seed/export-tutorials.ts"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
