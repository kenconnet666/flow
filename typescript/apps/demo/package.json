    "@zerodep-dev/json-wire": "^0.1.0",
    "@zerodep-dev/vue-tsx-pro-tsx": "link:../../../../vue-tsx-pro/packages/tsx",
    "@zerodep-dev/vue-tsx-pro-ui": "link:../../../../vue-tsx-pro/packages/ui",
    "decimal.js": "catalog:",
    "shiki": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
