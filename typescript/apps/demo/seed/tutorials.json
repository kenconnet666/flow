{
  "forms": [
    {
      "key": "expense-form",
      "name": "报销单",
      "category": null,
      "manifest": {
        "title": {
          "label": "标题",
          "type": "text",
          "required": true
        },
        "amount": {
          "label": "金额",
          "type": "decimal",
          "required": true
        },
        "category": {
          "label": "费用类别",
          "type": "select",
          "options": [
            {
              "value": "差旅",
              "label": "差旅"
            },
            {
              "value": "办公",
              "label": "办公"
            },
            {
              "value": "招待",
              "label": "招待"
            }
          ],
          "required": true
        },
        "companions": {
          "label": "同行人",
          "type": "people",
          "visibleWhen": {
            "all": [
              {
                "field": "form.category",
                "op": "eq",
                "value": "差旅"
              }
            ]
          }
        },
        "invoice": {
          "label": "发票",
          "type": "file"
        },
        "items": {
          "label": "费用明细",
          "type": "list",
          "fields": {
            "item": {
              "label": "项目",
              "type": "text"
            },
            "money": {
              "label": "金额",
              "type": "decimal"
            }
          }
        },
        "note": {
          "label": "财务意见",
          "type": "text"
        },
        "spentOn": {
          "label": "发生日期",
          "type": "date"
        }
      },
      "clientSource": "import { defineFields, defineFlowForm, FileField } from '@zerodep-dev/flow-ui/form';\nimport { Flex, TextField, NumberField, Select, PeoplePicker, Textarea, DatePicker } from '@zerodep-dev/vue-tsx-pro-ui';\n\nexport const fields = defineFields({ title: { label: '标题', type: 'text', required: true },\namount: { label: '金额', type: 'decimal', required: true },\ncategory: {\n  label: '费用类别',\n  type: 'select',\n  options: [{ value: '差旅', label: '差旅' }, { value: '办公', label: '办公' }, { value: '招待', label: '招待' }],\n  required: true,\n},\ncompanions: {\n  label: '同行人',\n  type: 'people',\n  visibleWhen: { all: [{ field: 'form.category', op: 'eq', value: '差旅' }] },\n},\ninvoice: { label: '发票', type: 'file' },\nitems: {\n  label: '费用明细',\n  type: 'list',\n  fields: { item: { label: '项目', type: 'text' }, money: { label: '金额', type: 'decimal' } },\n},\nnote: { label: '财务意见', type: 'text' },\nspentOn: { label: '发生日期', type: 'date' } });\n\nexport default defineFlowForm(fields, ({ form }) => () => (\n  <form.Form>\n    <Flex direction=\"column\" gap=\"md\">\n      <form.Field name=\"title\"><TextField /></form.Field>\n      <form.Field name=\"amount\"><NumberField /></form.Field>\n      <form.Field name=\"category\"><Select /></form.Field>\n      <form.Field name=\"companions\"><PeoplePicker /></form.Field>\n      <form.Field name=\"invoice\"><FileField /></form.Field>\n      <form.List name=\"items\" />\n      <form.Field name=\"note\"><Textarea /></form.Field>\n      <form.Field name=\"spentOn\"><DatePicker /></form.Field>\n    </Flex>\n  </form.Form>\n));\n",
      "serverLanguage": null,
      "serverSource": null,
      "note": "教程做完"
    }
  ],
